# Copy to .env and fill in. Never commit .env.

# Required ------------------------------------------------------------------------------
# The public HTTPS address of this server (no trailing path). Alexa and your Echo use it.
ECHO_TUNES_PUBLIC_URL=https://music.example.com
# Your skill ID from the Alexa Developer Console (comma-separate several).
ECHO_TUNES_SKILL_IDS=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional ------------------------------------------------------------------------------
# Country for search results (two letters: US, GB, IN, ...). Empty = YouTube decides.
ECHO_TUNES_LOCATION=
# Language for song and artist names: en, de, es, fr, hi, ja, zh_CN, ... (not en-US).
# ECHO_TUNES_LANGUAGE=en
# How many songs a radio adds at a time (5-50).
ECHO_TUNES_RADIO_LENGTH=25
# Longest queue kept per Echo (20-1000); played songs are dropped first.
# ECHO_TUNES_MAX_QUEUE=200
# A Netscape-format cookies.txt for yt-dlp, mounted into the container, if YouTube blocks
# your server (common on cloud servers). See docs/TROUBLESHOOTING.md.
# ECHO_TUNES_YTDLP_COOKIES=/data/cookies.txt
# Google sign-in (optional; see docs/GOOGLE_SIGN_IN.md). You can also type these in at
# `echo-tunes login`.
# ECHO_TUNES_GOOGLE_CLIENT_ID=
# ECHO_TUNES_GOOGLE_CLIENT_SECRET=
# Add songs you play to your YouTube history so recommendations learn (when signed in).
# ECHO_TUNES_SEND_HISTORY=false
# Private dashboard, /metrics and JSON API on a second port. Never publish it to the internet.
# ECHO_TUNES_DASHBOARD_PORT=8081
# Address the dashboard listens on (the Docker image uses 0.0.0.0; publish the port privately).
# ECHO_TUNES_DASHBOARD_HOST=127.0.0.1
# Needed to play, queue and clear history from the dashboard (user: admin).
# ECHO_TUNES_DASHBOARD_PASSWORD=
# Google accounts that may also sign in to the dashboard (the password keeps working). Uses
# the OAuth client from `echo-tunes login`; see docs/DASHBOARD.md.
# ECHO_TUNES_DASHBOARD_GOOGLE_EMAILS=you@gmail.com,partner@gmail.com
# Days a phone or browser stays signed in (0 = until you sign out; fine on a private network).
# ECHO_TUNES_DASHBOARD_SESSION_DAYS=180
# Token for monitors and scripts (Uptime Kuma, Prometheus): "Authorization: Bearer <token>".
# At least 32 random characters, e.g. the output of: openssl rand -hex 32
# ECHO_TUNES_DASHBOARD_API_TOKEN=
# Days of play history to keep (0 = none).
# ECHO_TUNES_HISTORY_DAYS=15
# Extra host names you open the dashboard by (no port), e.g. a local DNS name.
# ECHO_TUNES_DASHBOARD_HOSTS=music-dash.lan
# Friendly Echo names (last 12 characters of the ID, shown on the dashboard). Names can't
# contain commas: separate Echos with them.
# ECHO_TUNES_DEVICE_NAMES=LIVINGROOM01=Living room,K1TCHEN0ECHO=Kitchen
# Where data is kept. The Docker image uses /data; without Docker the default is ./data.
# ECHO_TUNES_DATA_DIR=./data
# Let the web player try to skip the song playing on an Echo (experimental; docs/DASHBOARD.md).
# ECHO_TUNES_EXPERIMENTAL_SKIP=false
# The dashboard installs as a phone app (over HTTPS): its name, accent colour (buttons and
# highlights; empty = the built-in violet) and icon.
# ECHO_TUNES_APP_NAME=echo-tunes
# ECHO_TUNES_APP_COLOR=#7c3aed
# ECHO_TUNES_APP_ICON=/data/icon.png
# Public port (Alexa and the Echo's audio) and the address it listens on.
# ECHO_TUNES_PORT=8080
# ECHO_TUNES_HOST=0.0.0.0
# Workers that prepare audio links in parallel (1-8), and songs each prepares before a fresh
# one replaces it (frees memory).
# ECHO_TUNES_RESOLVER_WORKERS=2
# ECHO_TUNES_RESOLVER_TASKS_PER_WORKER=25
# Hours an audio link handed to the Echo stays valid (1-48).
# ECHO_TUNES_STREAM_LINK_TTL_HOURS=12
# debug, info, warning, error or critical.
ECHO_TUNES_LOG_LEVEL=info
